<?xml version="1.0"?>
<robot name="hanuman" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Include all model properties-->
  <xacro:property name="description_package" value="Volta_rev4"/>
  <xacro:include filename="$(find ${description_package})/urdf/properties_L_fixed.xacro"/>
  <xacro:include filename="$(find ${description_package})/urdf/Volta_L_fixed.xacro" />
  
  <link name="world"/>
  <xacro:humanoid_Volta parent="world"/>

</robot>
